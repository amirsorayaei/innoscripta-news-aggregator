# Copy to .env (git-ignored). `pnpm dev`, `pnpm start` and Docker Compose load it
# when present; variables already exported in the shell take precedence.

# demo (default): bundled sample articles, no keys, no outbound requests.
# live: real provider requests; all three keys are required.
NEWS_MODE=demo

# Server-side only. Never prefix these with VITE_.
GUARDIAN_API_KEY=
NYT_API_KEY=
NEWSAPI_API_KEY=

# Optional: fixed "now" for Demo timestamps (ISO 8601, UTC).
# DEMO_NOW=2026-10-19T09:00:00Z

# Optional: API port for `pnpm dev` / `pnpm start` (Docker always uses 8080).
# PORT=8080
